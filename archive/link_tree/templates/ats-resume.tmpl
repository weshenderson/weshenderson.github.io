<!DOCTYPE html>
<html lang="en" data-theme="professional">
  <head>
    <title>$author, Resume</title>
    <link rel="shortcut icon" href="$icon">
    <link rel=icon type="image/ico" href="$icon">
    <link rel="stylesheet" type="text/css" href="../assets/css/srt-reset-fonts-grids.css" media="all">
    <link rel="stylesheet" type="text/css" href="../assets/css/ats-resume.css" media="all">
    <!-- <link rel="stylesheet" type="text/css" href="../assets/css/ats-resume.css" media="all"> -->
    <script type="text/javascript" src="../assets/js/konami.js"></script>
    <meta charset="utf-8">
    <meta name="author" content="$author">
    <meta name="description" content="$description">
    <meta name="keywords" content="$tags">
    <meta property="og:site_name" content="$author">
    <meta property="og:type" content="website">
    <meta property="og:title" content="$author">
    <meta property="og:description" content="$description">
    <meta property="og:image" content="$thumbnail">
    <meta property="og:image:secure_url" content="$thumbnail">
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:image" content="$thumbnail">
    $google
  </head>
  <body>
    <div id="doc2" class="yui-t7">
      <div id="inner">

        <div id="hd">
            <div class="yui-u first">
              <h1>$name</h1>
              <h2>$title</h2>
              <h3>$phone | $email | $city,$state_code | $linkedin</h3>
            </div>
        </div><!--// hd -->

        <div id="bd">
          <div id="yui-main">
            <div class="yui-b">

              <div class="yui-gf">
                <div class="yui-u first">
                  <h2>Summary</h2>
                </div>
                <div class="yui-u">
                  <p>
                    $summary
                  </p>
                </div>
              </div><!--// .yui-gf -->

              <div class="yui-gf">
                  <div class="yui-u first">
                      <h2>Skills</h2>
                  </div>
                  <div class="yui-u">
                    $skills
                  </div>
              </div><!--// .yui-gf-->
              <div class="yui-gf">
                <div class="yui-u first">
                  <h2>Relevant Experience</h2>
                </div><!--// .yui-u -->
                <div class="yui-u">
                  $experience
                </div><!--// .yui-u -->
              </div><!--// .yui-gf -->

                      $certifications

              <div class="yui-gf">
                <div class="yui-u first">
                  <h2>Education</h2>
                </div>
                <div class="yui-u">
                  $education
                </div>
              </div><!--// .yui-gf -->

              <div class="yui-gf">
                  <div class="yui-u first">
                      <h2>Publications</h2>
                  </div>
                  <div class="yui-u">
                    $publications
                  </div>
              </div><!--// .yui-gf-->

              <div class="yui-gf last">
                <div class="yui-u first">
                  <h2>Volunteer Work</h2>
                </div>
                <div class="yui-u">
                  $volunteer
                </div>
              </div><!--// .yui-gf -->

            </div><!--// .yui-b -->
          </div><!--// yui-main -->
        </div><!--// bd -->

        <div id="ft">
          <p>$name &mdash; <a href="mailto:$email?subject=$subject">$email</a> &mdash; $phone</p>
        </div><!--// footer -->

      </div><!-- // inner -->
    </div><!--// doc -->
  </body>
</html>
