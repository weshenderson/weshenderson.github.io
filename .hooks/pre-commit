#!/usr/bin/env bash
set -eo pipefail
set -x

BASE_PATH="$(git rev-parse --show-toplevel)"
RESUME_SRC='resume.yaml'
JSON_RESUME='resumes/resume.json'
PYTHON_FILES="$(git diff --cached --name-only --diff-filter=d | grep -q .py$)" ||:

echo 'test'
function alea {
    if git status --porcelain | grep -q ${RESUME_SRC}; then
        pushd "${BASE_PATH}" &>/dev/null
            ./alea.py --json
            git add ${JSON_RESUME}
        popd
    fi
}

function check-code {
    if echo ${PYTHON_FILES} | grep -q '.py'; then
        echo -e 'Linting staged Python files: pylint.\n'
        pylint ${PYTHON_FILES}
    fi
}

check-code
alea
